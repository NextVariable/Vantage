{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sourceglint.dev/research_plan.schema.json",
  "title": "Research Plan",
  "description": "Structured description of ONE research task, produced by the Research Planner BEFORE any search happens (PRD §4). Modes: general | trend | competitor | market | voc | launch | channel. Time window supports relative (days) and custom (start/end) forms.",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic", "mode", "time_window"],
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1,
      "description": "What the research is about (PRD §4)."
    },
    "entities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Named entities (products/companies/people). Optional for  open market scans."
    },
    "market": {
      "$ref": "https://schemas.sourceglint.dev/common.schema.json#/$defs/market_code",
      "description": "Target market. Absent = global."
    },
    "locale": {
      "$ref": "https://schemas.sourceglint.dev/common.schema.json#/$defs/locale_code"
    },
    "languages": {
      "type": "array",
      "items": { "$ref": "https://schemas.sourceglint.dev/common.schema.json#/$defs/language_code" },
      "uniqueItems": true,
      "minItems": 1,
      "description": "Languages to research in. Never assume English covers a  local market (PRD §5)."
    },
    "time_window": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["days"],
          "properties": {
            "days": {
              "type": "integer",
              "minimum": 1,
              "description": "Relative window: last N days (7/14/30/90)."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "https://schemas.sourceglint.dev/common.schema.json#/$defs/iso_timestamp" },
            "end": { "$ref": "https://schemas.sourceglint.dev/common.schema.json#/$defs/iso_timestamp" }
          },
          "description": "Custom window. start <= end is a VALIDATOR concern  (Phase 2), not a schema concern."
        }
      ]
    },
    "decision_context": {
      "type": "string",
      "minLength": 1,
      "description": "Why this research runs + what decision it feeds (PRD §4).  Drives Decision Relevance scoring."
    },
    "mode": {
      "type": "string",
      "enum": ["general", "trend", "competitor", "market", "voc", "launch", "channel"]
    },
    "required_evidence_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["T1_official", "T2_community", "T3_marketplace", "T4_secondary"]
      },
      "uniqueItems": true,
      "description": "Evidence tiers the answer must lean on (v0.2 §8.1)."
    },
    "queries": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Expanded queries. May be empty before expansion runs."
    },
    "goal": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S" },
    "research_objects": {
      "type": "array", "maxItems": 8, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" }
    },
    "intents": {
      "type": "array", "uniqueItems": true, "maxItems": 5,
      "items": { "enum": ["industry", "demand", "competition", "opportunity", "general"] }
    },
    "hypotheses": {
      "type": "array", "maxItems": 5, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["statement", "disconfirming_evidence"],
        "properties": {
          "statement": { "type": "string", "minLength": 1, "maxLength": 240 },
          "disconfirming_evidence": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "open_conditions": {
      "type": "array", "maxItems": 5, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["rounds", "initial_routes", "followup_routes", "max_queries", "max_per_source",
                   "timeout_seconds", "assessment_evidence_items"],
      "properties": {
        "rounds": { "type": "integer", "minimum": 1, "maximum": 3 },
        "initial_routes": { "const": 6 },
        "followup_routes": { "const": 3 },
        "max_queries": { "type": "integer", "minimum": 6, "maximum": 12 },
        "max_per_source": { "type": "integer", "minimum": 1, "maximum": 24 },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 300 },
        "assessment_evidence_items": { "const": 40 }
      }
    },
    "stop_conditions": {
      "type": "array", "uniqueItems": true, "maxItems": 8,
      "items": { "type": "string" }
    },
    "retrieval_strategy": {
      "type": "object", "additionalProperties": false,
      "description": "Deterministic record of how the plan will be executed (evidence needs, priority, routing and stopping rules).",
      "properties": {
        "initial_route_limit": { "type": "integer", "minimum": 1 },
        "followup_route_limit": { "type": "integer", "minimum": 0 },
        "query_languages": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "source_order": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "followup_rule": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "opportunity_requested": { "type": "boolean" },
    "subquestions": {
      "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "priority", "evidence_types", "preferred_sources",
                     "completion_criterion", "minimum_origins", "query", "language"],
        "properties": {
          "id": { "type": "string", "pattern": "^q[1-6]$" },
          "focus": { "enum": ["industry", "demand", "competition", "opportunity", "general"] },
          "question": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 6 },
          "evidence_types": {
            "type": "array", "uniqueItems": true, "maxItems": 4,
            "items": { "enum": ["T1_official", "T2_community", "T3_marketplace", "T4_secondary"] },
            "description": "All evidence tiers useful for this question. Supporting tiers do not block coverage."
          },
          "required_evidence": {
            "type": "array", "uniqueItems": true, "maxItems": 2,
            "items": { "enum": ["T1_official", "T2_community", "T3_marketplace", "T4_secondary"] },
            "description": "Tiers a covered answer must contain. Must not be relaxed to raise coverage."
          },
          "supporting_evidence": {
            "type": "array", "uniqueItems": true, "maxItems": 4,
            "items": { "enum": ["T1_official", "T2_community", "T3_marketplace", "T4_secondary"] },
            "description": "Useful tiers that add confidence but do not block coverage."
          },
          "evidence_requirements": {
            "type": "object",
            "additionalProperties": false,
            "description": "Engine-derived sufficiency conditions: evidence kind, directness and independent origins rather than a mandatory website.",
            "properties": {
              "focus": { "enum": ["industry", "demand", "competition", "opportunity", "general"] },
              "roles_any_of": {
                "type": "array", "uniqueItems": true,
                "items": { "enum": ["vendor_claim_verified", "vendor_claim_unverified", "firsthand_experience",
                                     "independent_test", "media_report", "third_party_commentary", "unknown"] }
              },
              "min_independent_origins": { "type": "integer", "minimum": 1 },
              "min_direct_observations": { "type": "integer", "minimum": 0, "maximum": 3 },
              "blocking_tiers": {
                "type": "array", "uniqueItems": true,
                "items": { "enum": ["T1_official", "T2_community", "T3_marketplace", "T4_secondary"] }
              },
              "preferred_tiers": {
                "type": "array", "uniqueItems": true,
                "items": { "enum": ["T1_official", "T2_community", "T3_marketplace", "T4_secondary"] }
              },
              "derived_from_focus": { "type": "boolean" }
            }
          },
          "preferred_sources": {
            "type": "array", "uniqueItems": true, "maxItems": 4,
            "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9_]+$" }
          },
          "completion_criterion": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S" },
          "minimum_origins": { "type": "integer", "minimum": 1, "maximum": 3 },
          "query": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S" },
          "language": { "type": "string", "pattern": "^[a-z]{2,3}$" }
        }
      }
    },
    "source_priorities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Ordered source names from sources.yaml. Absent = registry default order."
    }
  }
}
